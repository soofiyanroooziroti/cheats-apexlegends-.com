---
import { getLocaleFromAstro, getTranslations } from '../../i18n';
import type { ProductFeatureGroup } from '../../data/products';
import { productPath } from '../../utils/path';
import Icon from '../icons/Icon.astro';
import SlideRevealButton from '../SlideRevealButton.astro';
import SectionHeader from '../SectionHeader.astro';

interface Props {
  featureGroups?: ProductFeatureGroup[];
}

const locale = getLocaleFromAstro(Astro);
const t = getTranslations(locale);
const productUi = (t as { productUi?: Record<string, string> }).productUi ?? {};
const panel = (t.productUi as { systemReqPanel?: { security: string[]; specs?: { label: string; value: string }[] } })
  .systemReqPanel;

const { featureGroups = [] } = Astro.props;

const previewItems = featureGroups.flatMap((g) => g.items);
const columnCount = 4;
const columnSize = previewItems.length > 0 ? Math.ceil(previewItems.length / columnCount) : 0;
const columns = Array.from({ length: columnCount }, (_, i) =>
  previewItems.slice(i * columnSize, (i + 1) * columnSize),
).filter((col) => col.length > 0);

const featuresHref = `${productPath('loader', locale)}#features`;
const deckTitle = productUi.shopDeckTitle ?? 'Quick look at the menu';
const deckDesc =
  productUi.shopDeckDesc ??
  'Requirement pills and included features—open the feature list for full notes on each option.';
---

<section class="product-shop-deck border-y border-border bg-muted/20 py-8 md:py-10" aria-labelledby="product-shop-deck-title">
  <div class="mx-auto max-w-6xl px-5">
    <div class="product-shop-deck__header">
      <SectionHeader
        eyebrow={productUi.shopDeckEyebrow ?? 'Preview'}
        title={deckTitle}
        desc={deckDesc}
        titleId="product-shop-deck-title"
      />
    </div>

    <ul class="product-shop-deck__pills flex flex-wrap gap-2" role="list">
      {(panel?.security ?? []).map((label) => (
        <li class="product-shop-deck__pill">
          <Icon name="circleCheck" size={16} class="shrink-0 text-primary" aria-hidden="true" />
          <span>{label}</span>
        </li>
      ))}
      <li class="product-shop-deck__pill">
        <Icon name="monitor" size={16} class="shrink-0 text-primary" aria-hidden="true" />
        <span>Windows 10 &amp; 11</span>
      </li>
      <li class="product-shop-deck__pill">
        <Icon name="shieldCheck" size={16} class="shrink-0 text-primary" aria-hidden="true" />
        <span>Latest Apex Legends PC client</span>
      </li>
    </ul>

    <div class="product-shop-deck__columns mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        columns.map((col) => (
          <div class="product-shop-deck__col">
            <ul class="product-shop-deck__list" role="list">
              {col.map((item) => (
                <li>
                  <Icon name="chevronRight" size={14} class="shrink-0 text-primary" aria-hidden="true" />
                  <span>{item.name}</span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="mt-6 flex justify-start">
      <SlideRevealButton href={featuresHref}>{productUi.shopViewAllFeatures ?? 'See all features'}</SlideRevealButton>
    </div>
  </div>
</section>
